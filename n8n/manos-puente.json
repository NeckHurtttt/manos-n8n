    {
      "id": "964d2346-f015-5be2-9970-63b0d2548bc8",
      "name": "IA: texto → señas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2020,
        1140
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.cfg.ANTHROPIC_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5-5', max_tokens: 1024, output_config: { effort: 'low', format: { type: 'json_schema', schema: {\"type\": \"object\", \"properties\": {\"glosas\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"glosas\"], \"additionalProperties\": false} } }, fallbacks: 'default', system: \"Convierte una frase en español a glosas de Lengua de Señas Boliviana para un avatar: palabras sueltas, en minúsculas, en infinitivo, sin artículos ni preposiciones innecesarias, en el orden en que se señarían. Máximo 12 glosas. Si hay nombres propios, déjalos tal cual.\", messages: [{ role: 'user', content: $json.texto }] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "96c911c9-a5b1-5eaa-97ec-e8206b9b8c60",
      "name": "Leer glosas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        1140
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json, prev = $('¿Está en una sala?').item.json;\nlet glosas = [];\ntry { glosas = JSON.parse((r.content || []).filter(b => b.type === 'text').map(b => b.text).join('')).glosas || []; } catch {}\nreturn { json: { ...prev, glosas } };"
      }
    },
