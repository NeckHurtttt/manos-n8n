        "jsCode": "// Saca el texto de la respuesta de Claude (o cae a algo seguro si se negó o falló).\nconst r = $json, prev = $('Claves').item.json;\nconst texto = r.stop_reason === 'refusal' ? '' : (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('').trim();\nreturn { json: { ...prev, ia: texto } };"
      }
