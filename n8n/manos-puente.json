        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5-5', max_tokens: 1024, output_config: { effort: 'low' }, fallbacks: 'default', system: \"Eres intérprete de Lengua de Señas Boliviana (LSB). Recibes glosas: palabras sueltas en el orden en que se hicieron las señas, sin artículos ni conjugación, a veces deletreadas letra por letra. Devuelve UNA sola frase natural en el idioma pedido, en primera persona, corta, sin inventar datos que no estén en las glosas. Solo la frase, sin comillas ni explicaciones.\", messages: [{ role: 'user', content: `Idioma: ${$json.idioma || 'es'}\\nGlosas: ${($json.glosas || []).join(' ')}` }] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
