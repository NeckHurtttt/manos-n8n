    {
      "id": "c5a95907-3a89-5108-9a05-e4738fe05e22",
      "name": "Supabase: vincular sala",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        940
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { cfg } = $json;\nconst sb = (metodo, ruta, body, prefer = 'return=representation') => this.helpers.httpRequest({\n  method: metodo, url: `${cfg.SUPA_URL}/rest/v1/${ruta}`, body, json: true,\n  headers: { apikey: cfg.SUPA_KEY, Authorization: `Bearer ${cfg.SUPA_KEY}`, Prefer: prefer },\n});\n\nconst codigo = ($json.message.text.split(/\\s+/)[1] || '').toUpperCase();\nconst nombre = [$json.message.from?.first_name, $json.message.from?.last_name].filter(Boolean).join(' ') || 'Telegram';\nconst r = codigo ? await sb('PATCH', `salas?codigo=eq.${codigo}`, { chat_id: $json.message.chat.id, nombre }) : [];\nconst ok = Array.isArray(r) && r.length > 0;\nif (ok) await sb('POST', 'mensajes', { sala: codigo, dir: 'aviso', texto: `${nombre} entró a la sala por Telegram` }, 'return=minimal');\nreturn { json: { chat_id: $json.message.chat.id, texto: ok\n  ? `✅ Listo, ${nombre}. Estás en la sala ${codigo}.\\nMandame un audio o un texto y la persona sorda lo verá en señas. Lo que ella diga en señas te llega aquí.`\n  : '❌ No encontré esa sala. Abrí el link que te pasaron o escribí /start CODIGO.' } };"
      }
    },
